# 后端开发环境配置示例 - 复制为 .env 后按需修改

# 应用
PROMPTHUB_APP_ENV=development

# 服务器
PROMPTHUB_SERVER_HOST=0.0.0.0
PROMPTHUB_SERVER_PORT=8080
PROMPTHUB_SERVER_MODE=debug

# 日志
PROMPTHUB_LOG_LEVEL=info
PROMPTHUB_LOG_FORMAT=console

# 数据库（默认 PostgreSQL）
PROMPTHUB_DB_DRIVER=postgres
PROMPTHUB_DB_HOST=127.0.0.1
PROMPTHUB_DB_PORT=5432
PROMPTHUB_DB_USER=postgres
PROMPTHUB_DB_PASSWORD=postgres
PROMPTHUB_DB_DBNAME=prompthub
PROMPTHUB_DB_SSLMODE=disable

# JWT（生产环境务必替换）
PROMPTHUB_JWT_SECRET=replace-with-strong-secret
